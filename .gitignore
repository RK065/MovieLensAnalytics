# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env/
env/
ENV/

# Large Raw Datasets (MovieLens 25M ~1.3GB)
# Raw data should not be tracked in Git; download directly from GroupLens
data/raw/*.csv
data/raw/*.zip
data/processed/*
!data/processed/.gitkeep

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Spark / Hadoop runtime logs and warehouse
spark-warehouse/
metastore_db/
derby.log
*.log

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
